# Local development only. Copy to .env and replace every placeholder.
# On Railway, set these as service Variables instead of uploading this file.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False

# Initial administrator. Use a long unique password and keep it out of Git.
# Railway reads these as protected service Variables on the first deployment.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-long-unique-password
INITIAL_ADMIN_EMAIL=admin@example.com

# Local MySQL. Railway automatically provides MYSQL* variables when you add
# a MySQL service; do not set DATABASE_* there unless using an external DB.
DATABASE_NAME=gaam_kindergarten_db
DATABASE_USER=gaam_app
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

KINDERGARTEN_PHONE=0788919112
KINDERGARTEN_ADDRESS=Microrayan 3rd District, Kabul, Afghanistan
